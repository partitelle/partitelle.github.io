---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="100 89 327 323"
  overflow="visible"
  role="img"
  aria-label={label}
  class={className}
  data-whistle
>
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="22">
    <path class="whistle-ray whistle-ray-1" d="M196 150 178 116" />
    <path class="whistle-ray whistle-ray-2" d="M221 142V100" />
    <path class="whistle-ray whistle-ray-3" d="M246 150 264 116" />
  </g>
  <circle cx="394" cy="206" r="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="18" />
  <path
    d="M122 188H198V218H244V188H300A112 112 0 1 1 190.6 276H122A22 22 0 0 1 100 254V210A22 22 0 0 1 122 188Z"
    fill="currentColor"
  />
</svg>

<script>
  // Replays one whistle (under 1s) when the mark is hovered, tapped (a tap
  // fires pointerenter too) or focused, if it is focusable or inside a link
  // or button. Timings stay in CSS: this only rewinds the finished CSS
  // "whistle-blow" animations. It does nothing while any ray still moves, so
  // a whistle never restarts mid-cycle, and nothing under reduced motion
  // (there are no animations to rewind).
  for (const mark of document.querySelectorAll<SVGSVGElement>(
    "[data-whistle]",
  )) {
    const whistle = () => {
      const animations = mark.getAnimations({ subtree: true });
      if (animations.some((a) => a.playState === "running")) return;
      const blows = animations.filter(
        (a) => (a as CSSAnimation).animationName === "whistle-blow",
      );
      if (blows.length === 0) return;
      const start = Math.min(
        ...blows.map((a) => Number(a.effect?.getTiming().delay ?? 0)),
      );
      for (const blow of blows) {
        blow.currentTime = start;
        blow.play();
      }
    };
    mark.addEventListener("pointerenter", whistle);
    mark
      .closest("a, button, [tabindex]")
      ?.addEventListener("focusin", whistle);
  }
</script>
