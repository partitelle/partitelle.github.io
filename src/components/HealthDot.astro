---
import { it } from "../i18n/it";

const s = it.status;
const copy = {
  endpoint: it.links.health,
  label: s.dot.label,
  slow: s.dot.slow,
  checkedAt: s.dot.checkedAt,
  titles: {
    ok: s.states.up.title,
    degraded: s.states.degraded.title,
    unknown: s.states.unknown.title,
  },
};
// One 12 px box, five glyphs: only the one matching data-state is drawn, so
// the box never changes size. Shapes, not colors, tell the states apart.
const glyph = "hidden";
---
<span
  data-health-dot
  data-state="pending"
  data-copy={JSON.stringify(copy)}
  class="group inline-flex size-3 shrink-0"
  aria-hidden="true"
>
  <svg viewBox="0 0 12 12" class="size-3" aria-hidden="true" focusable="false">
    <g class="group-data-[state=pending]:block hidden">
      <circle cx="6" cy="6" r="5.25" fill="none" class="stroke-muted" stroke-width="1.5" />
    </g>
    <g class={`${glyph} group-data-[state=ok]:block`}>
      <circle cx="6" cy="6" r="6" class="fill-black" />
    </g>
    <g class={`${glyph} group-data-[state=degraded]:block`}>
      <circle cx="6" cy="6" r="5.25" fill="none" class="stroke-black" stroke-width="1.5" />
      <path d="M6 0A6 6 0 0 0 6 12Z" class="fill-black" />
    </g>
    <g class={`${glyph} group-data-[state=asleep]:block`}>
      <circle cx="6" cy="6" r="5.25" fill="none" class="stroke-black" stroke-width="1.5" />
      <circle cx="6" cy="6" r="2" class="fill-black" />
    </g>
    <g class={`${glyph} group-data-[state=unknown]:block`}>
      <circle cx="6" cy="6" r="5.25" fill="none" class="stroke-black" stroke-width="1.5" />
      <path d="M2.6 9.4 9.4 2.6" fill="none" class="stroke-black" stroke-width="1.5" stroke-linecap="round" />
    </g>
  </svg>
</span>

<script>
  // Shows whether the bot answered, as a small shape in the header. At most
  // one request per tab every 10 minutes, after the page has loaded and is
  // idle and visible. No polling, no retry, no re-check on focus. On the
  // status page the panel is the only check: the dot mirrors its events.
  // Only the state is used: nothing from the response reaches the page.
  import {
    checkHealth,
    HEALTH_EVENT,
    type HealthEventDetail,
    type HealthEventState,
    readCachedHealth,
    writeCachedHealth,
  } from "../lib/health";

  type DotState = "pending" | "asleep" | "ok" | "degraded" | "unknown";
  interface Copy {
    endpoint: string;
    label: string;
    slow: string;
    checkedAt: string;
    titles: { ok: string; degraded: string; unknown: string };
  }

  const ORIGIN = "https://partitelle.com";
  const dot = document.querySelector<HTMLElement>("[data-health-dot]");
  const link = document.querySelector<HTMLElement>("[data-health-link]");
  if (dot && link) init(dot, link, JSON.parse(dot.dataset.copy ?? "{}") as Copy);

  function init(dot: HTMLElement, link: HTMLElement, copy: Copy) {
    const formatter = new Intl.DateTimeFormat("it-IT", {
      hour: "2-digit",
      minute: "2-digit",
    });

    const show = (state: DotState, at?: number) => {
      let label = copy.label;
      if (state === "asleep") {
        label = `${copy.label}: ${copy.slow}`;
      } else if (state !== "pending" && at !== undefined) {
        const time = formatter.format(new Date(at));
        label = `${copy.label}: ${copy.titles[state]}, ${copy.checkedAt} ${time}`;
      }
      dot.dataset.state = state;
      link.setAttribute("aria-label", label);
      link.setAttribute("title", label);
    };

    const showCached = () => {
      const cached = readCachedHealth();
      if (cached) show(cached.state, cached.at);
      return cached !== null;
    };

    if (document.querySelector("[data-status-panel]")) {
      document.addEventListener(HEALTH_EVENT, (event) => {
        const { state, at } = (event as CustomEvent<HealthEventDetail>).detail;
        const map: Record<HealthEventState, DotState> = {
          checking: "pending",
          waking: "asleep",
          ok: "ok",
          degraded: "degraded",
          unknown: "unknown",
        };
        show(map[state], at);
      });
      showCached();
      return;
    }

    const check = async () => {
      const result = await checkHealth(copy.endpoint, () => show("asleep"));
      const at = Date.now();
      writeCachedHealth(result, at);
      show(result, at);
    };

    const start = () => {
      if (showCached()) return;
      if (
        (navigator as Navigator & { connection?: { saveData?: boolean } })
          .connection?.saveData ||
        location.origin !== ORIGIN
      ) {
        return;
      }
      const whenIdle = () => {
        if ("requestIdleCallback" in window) {
          requestIdleCallback(() => void check(), { timeout: 3000 });
        } else {
          setTimeout(() => void check(), 1500);
        }
      };
      if (document.visibilityState === "visible") {
        whenIdle();
      } else {
        const onVisible = () => {
          if (document.visibilityState !== "visible") return;
          document.removeEventListener("visibilitychange", onVisible);
          whenIdle();
        };
        document.addEventListener("visibilitychange", onVisible);
      }
    };

    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
