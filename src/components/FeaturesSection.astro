---
import { it } from "../i18n/it";
import { chip } from "../lib/classes";
import ChatSummary from "./ChatSummary.astro";
import SectionLabel from "./SectionLabel.astro";

const { names } = it.panels;
const [summary, maybe, teams] = it.features.items;

const players = names.slice(0, 6).map((name, i) => ({
  name,
  status: i === 3 ? ("maybe" as const) : ("in" as const),
}));

const whiteTile =
  "rounded-panel border border-black/12 bg-white p-6 text-black lg:p-8";
const smallTitle = "text-xl leading-[1.15] lg:text-2xl";
const chipClass = `${chip} text-black`;
---
<section id="cosa-fa" aria-labelledby="features-title" class="bg-paper text-black">
  <div class="mx-auto w-full max-w-7xl px-6 py-16 lg:px-12 lg:py-24">
    <SectionLabel id="features-title">{it.features.title}</SectionLabel>
    <p class="mt-8 max-w-3xl text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-balance lg:text-5xl">{it.features.line}</p>
    <ul role="list" class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-12 lg:gap-6">
      <li class={`${whiteTile} sm:col-span-2 lg:col-span-7 lg:row-span-2 sm:grid sm:grid-cols-2 sm:gap-6 sm:items-start lg:flex lg:flex-col`}>
        <div>
          <h3 class="text-2xl leading-[1.1] lg:text-4xl">{summary.title}</h3>
          <p class="mt-4 max-w-[34rem] text-xl leading-relaxed text-muted">{summary.body}</p>
        </div>
        <div class="mt-8 sm:mt-0 lg:mt-auto lg:pt-8">
          <ChatSummary size="compact" visibleSlots={5} label={it.features.summaryLabel} players={players} />
        </div>
      </li>
      <li class={`${whiteTile} lg:col-span-5`}>
        <h3 class={smallTitle}>{maybe.title}</h3>
        <p class="mt-3 text-base leading-relaxed text-muted">{maybe.body}</p>
        <p class="mt-5"><span class={chipClass}>{maybe.keyword}</span></p>
      </li>
      <li class="on-dark rounded-panel bg-black p-6 text-white lg:col-span-5 lg:p-8">
        <h3 class={smallTitle}>{teams.title}</h3>
        <p class="mt-3 text-base leading-relaxed text-white">{teams.body}</p>
        <p class="mt-5"><span class={chipClass}>{teams.keyword}</span></p>
      </li>
    </ul>
  </div>
</section>
