---
import { it } from "../i18n/it";
import { ctaPill as pill } from "../lib/classes";
import SiteHeader from "./SiteHeader.astro";
import WhistleMark from "./WhistleMark.astro";
---
<section class="flex flex-col lg:min-h-svh bg-yellow text-black" aria-labelledby="hero-title">
  <SiteHeader />

  <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center gap-10 px-6 pb-16 pt-6 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-12">
    <div class="max-w-4xl text-left">
      <h1
        id="hero-title"
        class="text-[clamp(2.5rem,1.2rem+5.6vw,6rem)] leading-[1.05] text-balance"
      >
        {it.hero.title}
      </h1>
      <p class="mt-8 max-w-[34rem] text-xl leading-relaxed text-muted">{it.hero.subtitle}</p>
      <div class="mt-10 flex flex-col items-start gap-3">
        <a href={it.links.bot} class={`${pill} text-lg`}>{it.hero.ctaPrimary}</a>
        <p class="text-sm text-muted">{it.hero.availability}</p>
      </div>
    </div>
    <WhistleMark
      label={it.site.markLabel}
      class="w-28 sm:w-40 lg:w-[clamp(11rem,34vw,26rem)] shrink-0 self-start text-black lg:self-center"
    />
  </div>
</section>
