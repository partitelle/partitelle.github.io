---
import { it } from "../i18n/it";
import { inlineLink } from "../lib/classes";

type Credit = string | { text: string; href: string };

interface Props {
  id: string;
  class?: string;
  title: string;
  sources: { src: string; media?: string }[];
  captions: string;
  poster: {
    src: string;
    srcset: string;
    sizes: string;
    width: number;
    height: number;
  };
  durationLabel: string;
  durationA11y: string;
  credits: readonly (readonly Credit[])[];
  transcript: readonly string[];
}

const {
  id,
  class: className,
  title,
  sources,
  captions,
  poster,
  durationLabel,
  durationA11y,
  credits,
  transcript,
} = Astro.props;
const { video } = it;
const titleId = `${id}-title`;
const fill = "absolute inset-0 size-full rounded-panel";
---
<div id={id} role="group" aria-labelledby={titleId} data-video class:list={["mt-16 lg:mt-24", className]}>
  <h3 id={titleId} class="text-2xl leading-title">{title}</h3>
  <figure class="mt-6">
    <div class="relative aspect-video w-full max-w-video rounded-panel border border-line">
      <video controls preload="none" playsinline class:list={[fill, "bg-black object-cover"]}>
        {sources.map((source) => <source src={source.src} type="video/mp4" media={source.media} />)}
        <track kind="captions" srclang="it" label={video.captionsLabel} src={captions} default />
      </video>
      <button
        hidden
        type="button"
        data-video-start
        aria-label={`${video.playLabel}, ${durationA11y}`}
        class:list={[fill, "video-start cursor-pointer overflow-hidden"]}
      >
        <img
          src={poster.src}
          srcset={poster.srcset}
          sizes={poster.sizes}
          width={poster.width}
          height={poster.height}
          alt=""
          loading="lazy"
          decoding="async"
          class="absolute inset-0 size-full object-cover"
        />
        <span class="video-play absolute right-3 bottom-3 inline-flex size-12 items-center justify-center gap-3 rounded-pill bg-black text-base font-medium text-white sm:right-6 sm:bottom-6 sm:w-auto sm:px-5">
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 translate-x-0.5 fill-current sm:translate-x-0"><path d="M3 1v14l11-7z" /></svg>
          <span class="hidden after:content-[attr(data-duration)] sm:inline" data-duration={` · ${durationLabel}`}>{video.playLabel}</span>
        </span>
      </button>
    </div>
    <figcaption class="mt-3 w-full max-w-video text-sm font-medium text-muted">
      {
        credits.map((line) => (
          <p>
            {line.map((part) =>
              typeof part === "string" ? part : <a href={part.href} class={inlineLink}>{part.text}</a>,
            )}
          </p>
        ))
      }
    </figcaption>
  </figure>
  <details class="mt-4 w-full max-w-video">
    <summary class="min-h-12 w-fit cursor-pointer py-3 text-base font-medium underline-offset-4 decoration-2 hover:underline">{video.transcriptSummary}</summary>
    {transcript.map((line) => <p class="mt-2 max-w-lead text-base leading-relaxed text-muted">{line}</p>)}
  </details>
</div>

<script is:inline>
  for (const root of document.querySelectorAll("[data-video]")) {
    const video = root.querySelector("video");
    const start = root.querySelector("[data-video-start]");
    const poster = start.querySelector("img");
    video.controls = false;
    start.hidden = false;
    video.addEventListener("play", () => {
      video.controls = true;
      start.hidden = true;
    });
    start.addEventListener("click", () => {
      video.poster = poster.currentSrc;
      video.controls = true;
      start.hidden = true;
      const played = video.play();
      if (played) played.catch(() => {});
      video.focus();
    });
  }
</script>
